<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <!--
      Produces both GitHub release assets in one run. Ahnenblatt expects
      PlugIns\KekuleHtml.abp next to PlugIns\KekuleHtml\<binaries>, so publish
      straight into the KekuleHtml subfolder; GitHubRelease.targets then zips
      folder (standalone) and its parent (plugin) into artifacts\.
    -->
    <PackReleaseAssets>true</PackReleaseAssets>
    <ReleaseStageDir>bin\Release\net10.0-windows\release\</ReleaseStageDir>
    <PublishDir>$(ReleaseStageDir)KekuleHtml\</PublishDir>
    <!--
      The macOS archive is built from the console project alone and must stay
      outside $(ReleaseStageDir), or it would end up inside the plugin archive.
    -->
    <MacOsStageDir>bin\Release\net10.0-windows\release-macos\</MacOsStageDir>
  </PropertyGroup>
</Project>
