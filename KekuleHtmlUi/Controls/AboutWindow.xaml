<Window x:Class="KekuleHtmlUi.Controls.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localProperties="clr-namespace:KekuleHtmlUi.Properties"
        Title="{x:Static localProperties:Resources.AboutWindowTitle}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="28 22"
                MinWidth="300"
                HorizontalAlignment="Center">

        <!-- Application icon -->
        <Image Source="pack://application:,,,/Resources/KekuleHtmlIcon.ico"
               Width="64"
               Height="64"
               Margin="0 0 0 12"
               HorizontalAlignment="Center" />

        <!-- Application name -->
        <TextBlock FontSize="20"
                   FontFamily="Lucida Sans, Lucida Sans Unicode, Segoe UI"
                   FontWeight="Regular"
                   HorizontalAlignment="Center"
                   TextAlignment="Center">
            
            <!-- Comment is essential to prevent whitespace between both Runs and still maintain code formatting. -->
            <Run Text="Kekule"
                 Foreground="#06382D" /><!--
         --><Run Text="Html"
                 Foreground="#6E991B" />
        </TextBlock>

        <!-- Version (filled in code-behind from the assembly version) -->
        <TextBlock x:Name="VersionText"
                   Margin="0 8 0 0"
                   Foreground="Gray"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />

        <!-- Copyright -->
        <TextBlock Text="{x:Static localProperties:Resources.AboutCopyright}"
                   Margin="0 2 0 0"
                   Foreground="Gray"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />

        <Separator Margin="0 16" />

        <!-- Links (targets set in code-behind; opened in the default browser) -->

        <!-- License -->
        <TextBlock Margin="0 3"
                   HorizontalAlignment="Center"
                   TextAlignment="Center">
            <Hyperlink x:Name="LicenseLink"
                       RequestNavigate="Hyperlink_RequestNavigate">
                <Run Text="{x:Static localProperties:Resources.AboutLinkLicense}" />
            </Hyperlink>
        </TextBlock>

        <!-- Documentation -->
        <TextBlock Margin="0 3"
                   HorizontalAlignment="Center"
                   TextAlignment="Center">
            <Hyperlink x:Name="DocumentationLink"
                       RequestNavigate="Hyperlink_RequestNavigate">
                <Run Text="{x:Static localProperties:Resources.AboutLinkDocumentation}" />
            </Hyperlink>
        </TextBlock>

        <!-- Third Party -->
        <TextBlock Margin="0 3"
                   HorizontalAlignment="Center"
                   TextAlignment="Center">
            <Hyperlink x:Name="ThirdPartyLink"
                       RequestNavigate="Hyperlink_RequestNavigate">
                <Run Text="{x:Static localProperties:Resources.AboutLinkThirdParty}" />
            </Hyperlink>
        </TextBlock>

        <!-- Releases & Source Code -->
        <TextBlock Margin="0 3"
                   HorizontalAlignment="Center"
                   TextAlignment="Center">
            <Hyperlink x:Name="ReleasesLink"
                       RequestNavigate="Hyperlink_RequestNavigate">
                <Run Text="{x:Static localProperties:Resources.AboutLinkReleases}" />
            </Hyperlink>
        </TextBlock>

        <!-- Close -->
        <Button Content="{x:Static localProperties:Resources.AboutCloseButton}"
                Margin="0 20 0 0"
                Padding="16 4"
                HorizontalAlignment="Center"
                IsCancel="True"
                IsDefault="True"
                Click="CloseButton_Click" />

    </StackPanel>
</Window>